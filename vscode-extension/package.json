{
  "name": "diagram-studio-vscode",
  "displayName": "Diagram Studio",
  "description": "Visual editor for Diagram Studio JSON diagram files",
  "version": "0.2.4",
  "publisher": "ahsankhanamu",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahsankhanamu/diagram-studio"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diagramStudio",
          "title": "Diagram Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "diagramStudio.diagramEditor",
        "displayName": "Diagram Studio Editor",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "diagramStudio": [
        {
          "id": "diagramStudio.explorer",
          "name": "Diagram Studio",
          "icon": "media/icon.svg"
        }
      ],
      "explorer": [
        {
          "id": "diagramStudio.explorerPanel",
          "name": "Diagram Studio",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "diagramStudio.refreshExplorer",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Diagram Studio"
      },
      {
        "command": "diagramStudio.newDiagram",
        "title": "New Diagram",
        "icon": "$(add)",
        "category": "Diagram Studio"
      },
      {
        "command": "diagramStudio.exportAllAsHtml",
        "title": "Export Diagrams as HTML…",
        "icon": "$(export)",
        "category": "Diagram Studio"
      },
      {
        "command": "diagramStudio.exportSelectedAsHtml",
        "title": "Export Selected as HTML",
        "icon": "$(export)",
        "category": "Diagram Studio"
      },
      {
        "command": "diagramStudio.reformatAllDiagrams",
        "title": "Reformat Diagrams (Auto-layout)",
        "icon": "$(symbol-misc)",
        "category": "Diagram Studio"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "diagramStudio.newDiagram",
          "when": "view == diagramStudio.explorer || view == diagramStudio.explorerPanel",
          "group": "navigation@1"
        },
        {
          "command": "diagramStudio.exportSelectedAsHtml",
          "when": "view == diagramStudio.explorer || view == diagramStudio.explorerPanel",
          "group": "navigation@2"
        },
        {
          "command": "diagramStudio.refreshExplorer",
          "when": "view == diagramStudio.explorer || view == diagramStudio.explorerPanel",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "diagramStudio.exportSelectedAsHtml",
          "when": "(view == diagramStudio.explorer || view == diagramStudio.explorerPanel) && viewItem == diagramFolder",
          "group": "inline"
        },
        {
          "command": "diagramStudio.exportSelectedAsHtml",
          "when": "(view == diagramStudio.explorer || view == diagramStudio.explorerPanel) && viewItem == diagramFile",
          "group": "inline"
        },
        {
          "command": "diagramStudio.exportSelectedAsHtml",
          "when": "(view == diagramStudio.explorer || view == diagramStudio.explorerPanel) && viewItem == diagramFile",
          "group": "export@1"
        }
      ],
      "commandPalette": [
        {
          "command": "diagramStudio.reformatAllDiagrams",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:ext": "node esbuild.mjs",
    "package": "mkdir -p pkg && rm -f pkg/*.vsix && vsce package --no-dependencies -o pkg/",
    "deploy": "npm run package && cursor --install-extension pkg/*.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4"
  }
}
