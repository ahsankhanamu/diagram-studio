{
  "name": "diagram-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "mcp-server",
    "vscode-extension"
  ],
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "build:mcp": "npm run build --workspace=diagram-studio-mcp-server",
    "build:vscode": "npm run build --workspace=diagram-studio-vscode",
    "build:all": "npm run build && npm run build:mcp && npm run build:vscode",
    "preview": "vite preview --port 3001",
    "mcp:dev": "npm run dev --workspace=diagram-studio-mcp-server",
    "mcp:start": "npm run start --workspace=diagram-studio-mcp-server"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.4",
    "@dagrejs/dagre": "^2.0.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.0",
    "@xyflow/svelte": "^1.5.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^0.575.0",
    "nanoid": "^5.1.6",
    "svelte": "^5.53.3",
    "svelte-codemirror-editor": "^2.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
